#!/usr/bin/env bash
#
# SPDX-License-Identifier: GPL-3.0-or-later
#
# NetworkManager dispatcher：网络一变就重新测速换源（Live 与装后系统共用入口）。
#
# NM **同步**等 dispatcher 脚本跑完才继续自己的状态机，而测速要几十秒 —— 卡在这里，
# 换 Wi-Fi 就会表现为「连上了但半天不干活」。所以这里只做判断，真正的活甩到后台：
# setsid 另开一个会话，NM 返回后不会连坐把它收掉。
#
# 测速进程串行处理网络事件，等待期间已被新一轮测速覆盖的事件自动合并。

set -u

interface="${1:-}"
action="${2:-}"

case "$action" in
    up|vpn-up|connectivity-change|dhcp4-change|dhcp6-change) ;;
    *) exit 0 ;;
esac

# 日志进 journal 走的是**脚本自己**直写 /dev/log（systemd-journald 的 syslog socket），
# 所以这里不需要 `| systemd-cat` —— 也**不能**用管道：实测在 dispatcher 里
# `setsid A | systemd-cat &` 这条管道活不过钩子退出那个瞬间，脚本根本起不来
# （症状是 /run 下没有日志、mirrorlist 一动不动，而钩子退出码仍是 0）。
# /dev/log 直写不依赖任何进程存活，是这一层唯一稳的做法。
setsid /usr/local/bin/mipl-mirror-switch --trigger "$action" --interface "$interface" \
    >/dev/null 2>&1 </dev/null &

exit 0
