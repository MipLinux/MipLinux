#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""mipl-installer —— Live 侧安装器入口（Electron）

谁拉起它
--------
`profile/airootfs/etc/systemd/system/mipl-installer.service` → `/usr/local/bin/mipl-kiosk`
→ `seatd-launch -- cage -s /usr/local/bin/mipl-installer`。
构建把整个 `installer/` 拷到 `/usr/local/lib/mipl-installer/`，再把
`/usr/local/bin/mipl-{installer,kiosk}` 软链过去 —— 所以**本文件必须用
`os.path.realpath(__file__)` 找自己**，否则软链路径下找不到同级 `app/` 与 `theme/`。

本文件只干三件事，**不实现任何安装逻辑**：
1. **Chromium 初始化之前**算好首帧主题与设备层缩放（两者都必须在进程启动前定下来）；
2. 把 `--theme` / `--scale` / `--lang` 透给 Electron 主进程；
3. `exec` Electron —— 本进程被替换掉，信号直接落到 Electron 上，kiosk 的 stop/kill 语义才干净。

主题与缩放都是**纯函数**（`frontend/theme/*.py`，有单测）：
  - 主题：`--theme=auto|light|dark`；**默认 light**（亮色是主主题，维护者 2026-10-04），
    auto 才按本地时间（07:00–18:59 亮）；
  - 缩放：`--scale=1|2|3` 覆盖一切，否则读 sysfs DRM（分辨率 + EDID 物理尺寸）。

纪律：前端只画界面、不做安装逻辑；`installer/backend/` 不碰界面技术栈。
接口准据：`installer/frontend/app/README.md`。
"""

from __future__ import annotations

import argparse
import datetime
import importlib.util
import logging
import os
import re
import shutil
import sys
from pathlib import Path

LOG = logging.getLogger("mipl-installer")

THEME_CHOICES = ("auto", "light", "dark")
DEFAULT_THEME = "light"
SCALE_CHOICES = (1, 2, 3)
LANGUAGES = ("zh_CN", "en_US")
SOURCE_LANGUAGE = "zh_CN"

#: Electron 可执行文件：Live 里由 profile/packages.x86_64 的 electron44 提供。
ELECTRON_CANDIDATES = ("/usr/lib/electron44/electron", "/usr/bin/electron")

#: sysfs DRM 连接器目录：/sys/class/drm/card0-HDMI-A-1/{status,modes,edid}。
DRM_SYSFS = Path("/sys/class/drm")
_MODE_RE = re.compile(r"^\s*(\d+)\s*[xX]\s*(\d+)\s*$")

#: `--scale` 覆盖时写进判定依据的 source（手动覆盖「覆盖一切」）。
SOURCE_MANUAL_OVERRIDE = "manual-override"


# ───────────────────────────── 路径与纯函数模块 ─────────────────────────────

def frontend_dir() -> Path:
    """本文件所在目录（**realpath 之后**）—— 软链路径下只有 realpath 能找回同级目录。"""
    return Path(os.path.realpath(__file__)).parent


def load_pure_module(module_name: str, path: Path):
    """按路径加载 theme 线的纯函数模块（不进 sys.path，避免通用名撞车）。"""
    spec = importlib.util.spec_from_file_location(module_name, path)
    if spec is None or spec.loader is None:
        raise ImportError(f"加载不了纯函数模块：{path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[module_name] = module
    try:
        spec.loader.exec_module(module)
    except Exception:
        del sys.modules[module_name]
        raise
    return module


# ───────────────────────────── 设备层缩放（纯计算）─────────────────────────────

def _read_first_mode(path: Path):
    try:
        with path.open("r", encoding="ascii", errors="replace") as handle:
            for line in handle:
                match = _MODE_RE.match(line)
                if match:
                    return (int(match.group(1)), int(match.group(2)))
    except OSError:
        return None
    return None


def _read_edid_size(path: Path):
    """EDID 的 0x15 / 0x16 字节 = 最大横向 / 纵向图像尺寸（cm）→ mm。"""
    try:
        data = path.read_bytes()
    except OSError:
        return None
    if len(data) < 23:
        return None
    width_cm, height_cm = data[21], data[22]
    if width_cm == 0 or height_cm == 0:
        return None
    return (width_cm * 10.0, height_cm * 10.0)


def read_display_info(sysfs: Path = DRM_SYSFS):
    """扫 sysfs DRM，返回 `(resolution, physical_size)`；拿不到的项给 `None`（不编值）。"""
    try:
        status_paths = sorted(sysfs.glob("card*-*/status"))
    except OSError as exc:
        LOG.debug("扫描 %s 失败：%s", sysfs, exc)
        return (None, None)

    for status_path in status_paths:
        connector = status_path.parent
        try:
            status = status_path.read_text(encoding="ascii", errors="replace").strip()
        except OSError:
            continue
        if status and status != "connected":
            continue
        resolution = _read_first_mode(connector / "modes")
        if resolution is None:
            continue
        return (resolution, _read_edid_size(connector / "edid"))
    return (None, None)


def decide_device_scale(device_scale_module, override, resolution, physical_size):
    """`--scale` 覆盖一切；否则走 tech/08 §3.10 的四级判定。"""
    if override is not None:
        return device_scale_module.DeviceScale(
            override,
            source=SOURCE_MANUAL_OVERRIDE,
            reason=f"--scale={override} 手动覆盖一切",
        )
    return device_scale_module.device_scale(
        output_scale=None,
        physical_size=physical_size,
        resolution=resolution,
    )


# ───────────────────────────── 主题（纯计算）─────────────────────────────

def decide_initial_theme(theme_mode, theme_arg: str, now):
    """返回 `(theme, theme_source)`：显式 light/dark 走 manual，auto 走时间。"""
    if theme_arg == "auto":
        return (theme_mode.resolve_theme(now, theme_mode.SOURCE_AUTO), "auto")
    return (
        theme_mode.resolve_theme(now, theme_mode.SOURCE_MANUAL, manual_dark=(theme_arg == "dark")),
        "manual",
    )


# ───────────────────────────── 命令行 ─────────────────────────────

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="mipl-installer",
        description="MipLinux Live 安装器入口（Electron；由 mipl-kiosk 经 seatd-launch + cage 拉起）",
    )
    parser.add_argument("--theme", choices=THEME_CHOICES, default=DEFAULT_THEME,
                        help="首帧主题：light（默认）/ dark / auto（按本地时间 07:00–18:59）")
    parser.add_argument("--scale", type=int, choices=SCALE_CHOICES, default=None,
                        help="设备层缩放 1|2|3，覆盖一切自动判定（默认按 DRM 信息算）")
    parser.add_argument("--lang", choices=LANGUAGES, default=SOURCE_LANGUAGE,
                        help="界面语言：zh_CN（源语言，默认）/ en_US")
    parser.add_argument("--electron", default=None,
                        help="Electron 可执行文件（默认 /usr/lib/electron44/electron，再退 PATH）")
    parser.add_argument("--print-plan", action="store_true",
                        help="只打印将要执行的命令与判定依据后退出（宿主机排查用，不启动界面）")
    return parser


def find_electron(explicit):
    if explicit:
        return explicit
    for candidate in ELECTRON_CANDIDATES:
        if os.access(candidate, os.X_OK):
            return candidate
    return shutil.which("electron")


# ───────────────────────────── main ─────────────────────────────

def main(argv=None) -> int:
    argv = list(argv) if argv is not None else list(sys.argv)
    logging.basicConfig(level=logging.INFO, stream=sys.stderr,
                        format="%(levelname)s %(name)s: %(message)s")
    args = build_parser().parse_args(argv[1:])

    here = frontend_dir()
    app_dir = here / "app"
    theme_dir = here / "theme"
    if not (app_dir / "main.js").is_file():
        LOG.error("找不到 Electron 应用：%s（本文件在 %s）", app_dir, here)
        return 1

    try:
        theme_mode = load_pure_module("mipl_theme_mode", theme_dir / "theme_mode.py")
        device_scale_module = load_pure_module("mipl_device_scale", theme_dir / "device_scale.py")
    except (OSError, ImportError) as exc:
        LOG.error("加载 theme 纯函数失败：%s", exc)
        return 1

    # ---- ① 设备层缩放：先算，再写进 Chromium 的命令行 ----
    resolution, physical_size = read_display_info()
    decision = decide_device_scale(device_scale_module, args.scale, resolution, physical_size)
    if decision.log_required:
        # tech/08 §3.10 ④：拿不到任何信息时落 1x 也**必须**留一条日志，不静默
        LOG.warning("device scale 落到 %sx（来源 %s）：%s", int(decision), decision.source, decision.reason)
        for note in decision.notes:
            LOG.warning("device scale 备注：%s", note)
    LOG.info("设备层缩放 %sx（来源 %s）；判定：%s", int(decision), decision.source, decision.reason)

    # ---- ② 首帧主题 ----
    now = datetime.datetime.now()
    theme, theme_source = decide_initial_theme(theme_mode, args.theme, now)
    LOG.info("首帧主题 %s（themeSource=%s，本地时间 %s）", theme, theme_source, now)

    # ---- ③ 组装 Electron 命令行 ----
    electron = find_electron(args.electron)
    if electron is None:
        LOG.error("找不到 Electron（找过 %s 与 PATH）—— Live 里由 electron44 包提供",
                  "、".join(ELECTRON_CANDIDATES))
        return 1

    command = [
        electron,
        str(app_dir),
        f"--theme={theme}",
        f"--lang={args.lang}",
        # kiosk 场景的开关写死在启动器里，不散到别处：
        "--no-sandbox",                     # Live 里安装器就是 root，Chromium 沙箱在 root 下拒绝启动
        "--ozone-platform=wayland",         # cage 是 Wayland 合成器；Live 里没有 XWayland 可退
        f"--force-device-scale-factor={int(decision)}",
        # QEMU 无 GPU：用 Chromium 自带的 SwiftShader 软渲染，不额外装驱动
        "--use-gl=angle",
        "--use-angle=swiftshader",
    ]
    LOG.info("exec：%s", " ".join(command))
    if args.print_plan:
        print(" ".join(command))
        return 0

    # ---- ④ exec：本进程被 Electron 取代（信号直落 Electron，stop/kill 语义才干净）----
    try:
        os.execv(electron, command)
    except OSError as exc:
        LOG.error("启动 Electron 失败：%s", exc)
        return 1


if __name__ == "__main__":
    sys.exit(main())
