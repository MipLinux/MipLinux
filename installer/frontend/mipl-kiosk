#!/bin/bash
# Live 侧 kiosk 入口：cage 全屏拉起安装器界面。
# 由 mipl-installer.service 的 ExecStart 直接 execve —— 没有 shebang 时
# 内核返回 ENOEXEC，systemd 一律记成 203/EXEC，窗口不会出现（Issue #51）。
if systemd-detect-virt -q; then
      export WLR_RENDERER=pixman
fi

# 必须先过 seatd-launch，不能直接 exec cage。
#
# cage 基于 wlroots，起 DRM 会话要经 libseat 拿一个 seat。实测（Live 串口日志）
# libseat 两条路都不通，它自己的原话：
#   Could not connect to socket /run/seatd.sock: No such file or directory
#   [backend/logind.c:638] Could not get primary session for user: No data available
#   No backend was able to open a seat → Unable to create seat
#   → [cage] Unable to create the wlroots backend（每次都在 0.000 秒就死）
# seatd 没起，而 logind 那条要求调用方有登录会话 —— systemd 服务没有，
# 所以每一次尝试都必然失败（当时靠 Restart=on-failure 反复重来，那条已经去掉，
# 见 mipl-installer.service 的注释）。
#
# seatd-launch 就是为这个场景准备的（man seatd-launch）：它起一个专用 seatd、
# **等它就绪**，再把命令跑起来（设好 SEATD_SOCK，命令结束就收掉 seatd）。
# 用它就不依赖「开机时守护进程有没有就绪」这个时序。
#
# 代价：seatd 成了硬依赖。它在 Live 里由 wlroots0.20 间接拉进来（cage 的依赖），
# 不用往 packages.x86_64 里加；但如果以后有人把 seatd 裁掉，这里会立刻起不来。
#
# seatd-launch 的 socket 路径**写死** /run/seatd.sock（2026-09-25 实测：SEATD_SOCK
# 环境变量对它无效，它也没有 -s 之类的选项）。它只在子进程正常结束时才收掉 socket ——
# 被 systemd SIGTERM 掉（systemctl stop / kill）就留下一个残留的 socket，下一次 seatd
# 直接拒绝启动：
#   Socket file found at socket path /run/seatd.sock, refusing to start
#   seatd exited prematurely   →   status=1/FAILURE
# 于是「兜底之后用 systemctl start mipl-installer 把界面叫回来」这条路永远失败。
# 启动前清掉「没人监听」的那份：干净退出根本不会留下它，fuser 认不出就是残留
# （实测残留 → 退出码 1；活着的 seatd → 0）。
if [[ -S /run/seatd.sock ]] && ! fuser -s /run/seatd.sock 2>/dev/null; then
      rm -f /run/seatd.sock
fi

# cage 必须带 -s，否则 tty 切不出去（2026-09-25 实测 + 源码）。
#
# cage 把 Ctrl+Alt+F1..F12 当自己的 keybinding 处理，在 seat.c:handle_key_event 里
# 先按 Alt 修饰键拦下来交给 handle_keybinding —— 它在 !allow_vt_switch 时直接
# return false（既不切也不放行给内核 VT 层），只有 allow_vt_switch 为真才调
# wlr_session_change_vt 去切。而 allow_vt_switch 就是命令行的 -s：
#   cage(1)  -s  Allow VT switching
# 少了它，屏幕永远停在 kiosk 上：Ctrl+Alt+F2 毫无反应、窗口不消失、不闪屏。
#
# 实测对照（2026-09-25，QEMU）：不带 -s → 切不动；
# systemctl stop mipl-installer.service（合成器退出）后再按 → 能切。
# 也就是说内核那条路本来是通的，是合成器把键吞了。
#
# 这一条不只关乎方便：tty1 是 Live 唯一的维护入口，mipl-installer.service 的
# 兜底单元（mipl-installer-tty.service）要把 tty1 交回 root —— 切不了 tty 时，
# 「面挂了还有 tty1」这句话在实机上不成立。
exec /usr/bin/seatd-launch -- /usr/bin/cage -s -- /usr/local/bin/mipl-installer
