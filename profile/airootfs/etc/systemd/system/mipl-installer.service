[Unit]
Description=MipLinux 安装器界面
After=getty@tty1.service
Conflicts=getty@tty1.service
# Conflicts= 把 tty1 上的 autologin getty 停掉，而 getty@.service 的 Restart=always
# 对「显式停止」不生效 —— 没人把它拉回来，安装器一走 tty1 就是空白，只能手动切 VT
# （2026-09-25 实测：kill 之后 unit inactive、getty@tty1 inactive、/dev/vcs1 全空）。
# tty1 是 Live 唯一的维护入口，所以走的每一条路都得有人兜底。
OnSuccess=mipl-installer-tty.service
OnFailure=mipl-installer-tty.service

[Service]
Type=simple
ExecStart=/usr/local/bin/mipl-kiosk
# 不写 Restart=：一是 systemctl kill 发的是 SIGTERM，在 systemd 里算干净退出，
# Restart=on-failure 对它根本不触发（2026-09-25 实测 NRestarts=0）；
# 二是「崩了就自动再来一次」和「崩了就把 tty1 交回用户」互斥 —— 实测两者同时配上
# 会互相抢作业。M0 的验收要的是后者。要重开界面：systemctl start mipl-installer。
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
RuntimeDirectory=mipl-installer
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/mipl-installer
Environment=QT_QPA_PLATFORM=wayland
# 关机 / 重启时的停机上限。默认 TimeoutStopSec=90s，而实机反馈：在 tty 里敲
# `reboot`，整个关机被安装器这个 stop job 拖住 —— 前台只显示一句
# 「A stop job is running for MipLinux 安装器界面」，没人知道在等什么。
# SIGTERM 之后最多等 5 秒，剩下的交给 SIGKILL（`SendSIGKILL=` 默认就是 yes）。
#
# **根因还没定**：2026-10-06 在开发机上实测过两件事 ——
#   1. Electron 主进程里 `process.on('SIGTERM')` 不会被调用（Chromium 顶掉了它），
#      所以「前端自己不退」这条路不成立；
#   2. 朝整个进程组发 SIGTERM，Electron 的 6 个进程 3 秒内全部消失，不留残留。
# 剩下的嫌疑在 cage / seatd-launch / 本 unit 的兜底作业（OnSuccess/OnFailure 那条），
# 要定案得有一份真机或 QEMU 的 `journalctl -b -1 -u mipl-installer -u mipl-installer-tty`。
# 在那之前，这条上限让「卡 90 秒」变成「最多卡 5 秒」—— 它不解释原因，只限制代价。
TimeoutStopSec=5s

[Install]
WantedBy=multi-user.target
